# Copy to .env and adjust as needed. Never commit .env.

# Base URL for every API call. Optional.
#
# Leave it unset: the app then calls "/api/" on its own origin, which is how
# it is served in production. A same-origin request is exempt from both CORS
# and SameSite cookie rules, so no cross-origin setup is required. The Vite
# dev server proxies "/api" to the local Django server, so dev matches prod.
#
# Set this only when the backend lives on a different host or port, e.g.:
#   VITE_API_BASE_URL=http://127.0.0.1:8000/api/
# Remember to add that frontend origin to the backend's CORS_ALLOWED_ORIGINS
# and CSRF_TRUSTED_ORIGINS, or the browser will drop the response.
VITE_API_BASE_URL=
